### Pipeline Method Design

#### Standard Pipeline Structure

```python
@transaction.atomic
def service_method(self, input_data, user) -> Dict[str, Any]:
    """
    Standard service method pipeline:
    1. Validation - Check existence, permissions, business rules
    2. Loading - Fetch required entities via repositories
    3. Processing - Execute core business logic (may call AI server)
    4. Persistence - Save changes via repositories
    5. Response - Return domain objects, DTOs, or simple dictionaries
    """
    # 1) Validation
    entity = self._validate_request(input_data, user)
    
    # 2) Loading
    related_entities = self._load_required_entities(entity)
    
    # 3) Processing
    result = self._execute_business_logic(entity, related_entities, input_data)
    
    # 4) Persistence
    saved_entities = self._persist_changes(result)
    
    # 5) Response
    return self._format_response(saved_entities)
```

#### Example: Video Processing with AI

```python
@transaction.atomic
def process_video(self, video_id: int, user, **params) -> Dict[str, Any]:
    # 1) Validation
    video = self.video_repo.get_by_id_and_user(video_id, user)
    if not video:
        raise NotFoundServiceError(f"Video {video_id} not found")
    
    if video.status != 'pending':
        raise ServiceError(f"Video {video_id} is not in pending status", status_code=400)
    
    # 2) Loading
    # Additional entities can be loaded if needed
    
    # 3) Processing - Call AI server
    ai_client = get_ai_client()
    ai_result = ai_client.process_video(
        video_id=video.id,
        video_path=video.file.path,
        **params
    )
    
    # 4) Persistence
    self.video_repo.update_status(video, 'processed')
    self.video_repo.update_result(video, ai_result)
    
    # 5) Response
    return {
        "video_id": video.id,
        "status": video.status,
        "result": ai_result
    }
```

### Transaction Management

#### Use-Case Level Transactions

```python
@transaction.atomic
def complex_workflow(self, data: Dict[str, Any], user) -> Dict[str, Any]:
    """
    All repository operations within this method are atomic.
    If any step fails, all changes rollback.
    """
    # All these operations are in one transaction
    entity1 = self.repo1.create(data['part1'])
    entity2 = self.repo2.update(entity1.id, data['part2'])
    entity3 = self.repo3.create_related(entity2.id, data['part3'])
    
    # If any step fails, all changes rollback
    return {"entity1": entity1, "entity2": entity2, "entity3": entity3}
```

#### Nested Service Calls

```python
# Outer service method
@transaction.atomic
def outer_service_method(self, data):
    # This transaction includes inner service calls
    result1 = self.inner_service_method(data['part1'])  # No @transaction.atomic here
    result2 = self.another_inner_method(data['part2'])  # No @transaction.atomic here
    return {"result1": result1, "result2": result2}

# Inner service methods (no @transaction.atomic)
def inner_service_method(self, data):
    # This runs within outer transaction
    return self.repo.create(data)
```

**Note**: Inner service methods should NOT have `@transaction.atomic` when called from outer service methods with transactions.

### Error Handling

#### Service Error Classes

```python
# backend/video/exceptions.py
class ServiceError(Exception):
    """Base service error with HTTP status code"""
    def __init__(self, message: str, status_code: int = 400):
        super().__init__(message)
        self.status_code = status_code
        self.message = message

class NotFoundServiceError(ServiceError):
    """Resource not found error"""
    def __init__(self, message: str = "Resource not found"):
        super().__init__(message, status_code=404)

class ValidationServiceError(ServiceError):
    """Validation error"""
    def __init__(self, message: str = "Validation failed"):
        super().__init__(message, status_code=400)

class ProcessingServiceError(ServiceError):
    """Processing error (e.g., AI server failure)"""
    def __init__(self, message: str = "Processing failed", status_code: int = 500):
        super().__init__(message, status_code)
```

#### Error Handling in Services

```python
@transaction.atomic
def process_video(self, video_id: int, user, **params):
    try:
        # Validation
        video = self.video_repo.get_by_id_and_user(video_id, user)
        if not video:
            raise NotFoundServiceError(f"Video {video_id} not found")
        
        # AI server call
        ai_client = get_ai_client()
        ai_result = ai_client.process_video(video_id, video.file.path, **params)
        
        # Persistence
        self.video_repo.update_status(video, 'processed')
        
        return {"video_id": video.id, "result": ai_result}
    
    except NotFoundServiceError:
        raise  # Re-raise service errors
    except ServiceError:
        raise  # Re-raise service errors
    except Exception as e:
        # Log unexpected errors
        logger.error(f"Unexpected error in process_video: {str(e)}", exc_info=True)
        raise ProcessingServiceError(f"Video processing failed: {str(e)}")
```

#### Error Mapping in Views

```python
# backend/video/views.py
from rest_framework.views import APIView
from rest_framework.response import Response
from video.services import VideoService
from video.exceptions import ServiceError

class VideoProcessView(APIView):
    def post(self, request, video_id):
        serializer = VideoProcessSerializer(data=request.data)
        serializer.is_valid(raise_exception=True)
        
        try:
            result = VideoService.process_video(
                video_id=video_id,
                user=request.user,
                **serializer.validated_data
            )
            return Response(result, status=status.HTTP_200_OK)
        except ServiceError as e:
            # Map service error to HTTP response
            return Response(
                {"detail": str(e)},
                status=e.status_code
            )
```

### Logging Strategy

#### Service-Level Logging

```python
import logging

logger = logging.getLogger(__name__)

class VideoService:
    @transaction.atomic
    def process_video(self, video_id: int, user, **params):
        logger.info(f"Starting video processing for video {video_id}, user {user.id}")
        
        try:
            # Processing logic
            result = self._execute_processing(video_id, **params)
            
            logger.info(f"Video processing completed for video {video_id}")
            return result
        
        except ServiceError as e:
            logger.warning(f"Video processing failed for video {video_id}: {str(e)}")
            raise
        except Exception as e:
            logger.error(f"Unexpected error in video processing for video {video_id}: {str(e)}", exc_info=True)
            raise ProcessingServiceError(f"Video processing failed: {str(e)}")
```

**Logging Guidelines**:
- **Info level**: Pipeline checkpoints, completion status
- **Warning level**: Expected errors (ServiceError)
- **Error level**: Unexpected errors with full traceback
- **Never log**: Secrets, passwords, PII (personally identifiable information)

### Prohibited Patterns

**Never do these in services**:

- **Direct model access**: Use repositories, not `Model.objects.get()`
- **Serializer coupling**: Don't import or use serializers in services
- **View logic**: No HTTP-specific logic (request/response objects)
- **Nested transactions**: Don't use `@transaction.atomic` on helper methods called from transactional methods
- **AI direct calls**: Always use HTTP client, never import AI utils directly
- **Skip error handling**: Always handle exceptions and map to ServiceError

#### Anti-Patterns

```python
# BAD: Direct model access
class VideoService:
    def get_video(self, video_id):
        return Video.objects.get(id=video_id)  # BAD

# GOOD: Repository usage
class VideoService:
    def __init__(self):
        self.video_repo = VideoRepository()
    
    def get_video(self, video_id):
        return self.video_repo.get_by_id(video_id)  # GOOD

# BAD: Direct AI function call
from ai_model.utils import process_video_function  # BAD

class VideoService:
    def process_video(self, video_id):
        result = process_video_function(video_id)  # BAD

# GOOD: HTTP client call
from config.ai_client import get_ai_client

class VideoService:
    def process_video(self, video_id):
        ai_client = get_ai_client()
        result = ai_client.process_video(video_id)  # GOOD
```

### Checklist

For each service method:

- [ ] **Pipeline structure**: validate → load → process → persist → return
- [ ] **Transaction boundary**: `@transaction.atomic` on use-case level
- [ ] **Repository usage**: No direct model access
- [ ] **AI client usage**: HTTP client, not direct function calls
- [ ] **Error handling**: Catch exceptions, map to ServiceError
- [ ] **Logging**: Info for checkpoints, error for failures
- [ ] **Return type**: Domain objects, DTOs, or simple dictionaries
- [ ] **No view logic**: No HTTP-specific code

