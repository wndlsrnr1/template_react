## Django Service Logic (Service Separation Context)

This guide covers Django service layer patterns for separated services, focusing on AI server client usage, transaction management, and error handling.

### Core Principles

- **Service layer orchestration**: Services coordinate repositories and external services (AI server)
- **Transaction boundaries**: Use `@transaction.atomic` for use-case level transactions
- **AI server via HTTP**: All AI processing goes through HTTP client, not direct function calls
- **Error mapping**: Map service errors to HTTP status codes
- **Pipeline pattern**: Structure service methods as clear pipelines (validate → load → process → persist → return)

### Service Architecture Pattern

```python
# backend/video/services.py
from django.db import transaction
from typing import Dict, Any, Optional
from video.repositories import VideoRepository
from video.exceptions import NotFoundServiceError, ServiceError
from config.ai_client import get_ai_client
import logging

logger = logging.getLogger(__name__)

class VideoService:
    """Service for video business logic"""
    
    def __init__(self):
        # Direct repository injection
        self.video_repo = VideoRepository()
        # AI client is obtained via get_ai_client() when needed
    
    @transaction.atomic
    def process_video(self, video_id: int, user, **params) -> Dict[str, Any]:
        """
        Pipeline: validate → load → process (AI) → persist → return
        
        Args:
            video_id: Video ID to process
            user: User requesting processing
            **params: Additional processing parameters
        
        Returns:
            Dict with video status and processing result
        
        Raises:
            NotFoundServiceError: If video not found
            ServiceError: If processing fails
        """
        # 1) Validation - Check video exists and user has permission
        video = self.video_repo.get_by_id_and_user(video_id, user)
        if not video:
            raise NotFoundServiceError(f"Video {video_id} not found")
        
        # 2) Load - Get required entities (if needed)
        # Additional entities can be loaded here
        
        # 3) Processing - Call AI server via HTTP client
        ai_client = get_ai_client()
        try:
            logger.info(f"Calling AI server for video {video_id}")
            ai_result = ai_client.process_video(
                video_id=video.id,
                video_path=video.file.path,
                **params
            )
        except Exception as e:
            logger.error(f"AI server call failed for video {video_id}: {str(e)}")
            raise ServiceError(
                f"AI processing failed: {str(e)}",
                status_code=500
            )
        
        # 4) Persistence - Update video status
        self.video_repo.update_status(video, 'processed')
        
        # 5) Response - Return domain objects/DTOs
        return {
            "video_id": video.id,
            "status": video.status,
            "result": ai_result
        }
```

### AI Server Client Usage

#### Client Initialization

```python
# backend/config/ai_client.py
import os
import requests
import time
from typing import Dict, Any, Optional
from functools import lru_cache

class AIServerClient:
    """HTTP client for AI server communication"""
    
    def __init__(self, base_url: str = None, timeout: int = 3600):
        self.base_url = base_url or os.getenv('AI_SERVER_URL', 'http://ai:8001')
        self.timeout = timeout  # For synchronous calls
        self.async_timeout = 30  # For asynchronous calls
    
    def process_video(self, video_id: int, video_path: str, **params) -> Dict[str, Any]:
        """Call AI server video processing endpoint (synchronous)"""
        url = f"{self.base_url}/ai/v1/video/process/"
        payload = {
            "video_id": video_id,
            "video_path": video_path,
            **params
        }
        
        # Retry logic with exponential backoff
        max_retries = 3
        for attempt in range(max_retries):
            try:
                response = requests.post(
                    url,
                    json=payload,
                    timeout=self.timeout
                )
                response.raise_for_status()
                return response.json()
            except requests.exceptions.Timeout:
                if attempt == max_retries - 1:
                    raise ServiceError("AI processing timeout", status_code=504)
                time.sleep(2 ** attempt)  # Exponential backoff
            except requests.exceptions.RequestException as e:
                if attempt == max_retries - 1:
                    raise ServiceError(f"AI processing failed: {str(e)}", status_code=500)
                time.sleep(2 ** attempt)
    
    def process_video_async(self, video_id: int, video_path: str, **params) -> Dict[str, Any]:
        """Call AI server video processing endpoint (asynchronous)"""
        url = f"{self.base_url}/ai/v1/video/process/async/"
        payload = {
            "video_id": video_id,
            "video_path": video_path,
            **params
        }
        
        try:
            response = requests.post(
                url,
                json=payload,
                timeout=self.async_timeout
            )
            response.raise_for_status()
            return response.json()  # Returns task_id
        except requests.exceptions.RequestException as e:
            raise ServiceError(f"AI async processing failed: {str(e)}", status_code=500)
    
    def get_task_status(self, task_id: str) -> Dict[str, Any]:
        """Get async task status from AI server"""
        url = f"{self.base_url}/ai/v1/video/process/async/{task_id}/status/"
        
        try:
            response = requests.get(url, timeout=10)
            response.raise_for_status()
            return response.json()
        except requests.exceptions.RequestException as e:
            raise ServiceError(f"Failed to get task status: {str(e)}", status_code=500)
    
    def enhance_image(self, image_path: str, **params) -> Dict[str, Any]:
        """Call AI server image enhancement endpoint"""
        url = f"{self.base_url}/ai/v1/image/enhance/"
        payload = {
            "image_path": image_path,
            **params
        }
        
        try:
            response = requests.post(url, json=payload, timeout=self.timeout)
            response.raise_for_status()
            return response.json()
        except requests.exceptions.RequestException as e:
            raise ServiceError(f"Image enhancement failed: {str(e)}", status_code=500)
    
    def enhance_transparent_image(self, image_path: str, **params) -> Dict[str, Any]:
        """Call AI server transparent image enhancement endpoint"""
        url = f"{self.base_url}/ai/v1/image/trans-enhance/"
        payload = {
            "image_path": image_path,
            **params
        }
        
        try:
            response = requests.post(url, json=payload, timeout=self.timeout)
            response.raise_for_status()
            return response.json()
        except requests.exceptions.RequestException as e:
            raise ServiceError(f"Transparent image enhancement failed: {str(e)}", status_code=500)

@lru_cache()
def get_ai_client() -> AIServerClient:
    """Get singleton AI server client instance"""
    return AIServerClient()
```

