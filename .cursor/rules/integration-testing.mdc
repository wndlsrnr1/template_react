### Phase 4: Performance Tests

#### Query Count Assertion

```python
# backend/video/tests/test_performance.py
from django.test import TestCase
from django.test.utils import override_settings
from video.services import VideoService

class VideoServicePerformanceTest(TestCase):
    """Performance tests for VideoService"""
    
    def test_list_videos_optimized_queries(self):
        """Given multiple videos, When list, Then use optimized queries"""
        # Create test data
        for i in range(10):
            Video.objects.create(
                user=self.user,
                title=f"Video {i}",
                file=f"video_{i}.mp4"
            )
        
        # Assert query count
        with self.assertNumQueries(2):  # One for videos, one for user
            videos = VideoService.list_user_videos(user=self.user)
            self.assertEqual(len(videos), 10)
```

#### Response Time Budget

```python
# backend/video/tests/test_performance.py
import time
from django.test import TestCase

class VideoAPIPerformanceTest(TestCase):
    """Performance tests for video API endpoints"""
    
    def test_video_list_response_time(self):
        """Given videos, When list, Then respond within time budget"""
        # Create test data
        for i in range(100):
            Video.objects.create(
                user=self.user,
                title=f"Video {i}",
                file=f"video_{i}.mp4"
            )
        
        # Measure response time
        start = time.time()
        response = self.client.get('/api/video/')
        elapsed = time.time() - start
        
        # Assert time budget (loose, informative)
        self.assertLess(elapsed, 1.0)  # Should respond within 1 second
        self.assertEqual(response.status_code, 200)
```

### Phase 5: Error Scenario Tests

#### AI Server Unavailable

```python
# backend/video/tests/test_error_scenarios.py
from django.test import TestCase
from unittest.mock import patch
from rest_framework.test import APIClient
import requests

class VideoErrorScenarioTest(TestCase):
    """Tests for error scenarios"""
    
    def setUp(self):
        self.client = APIClient()
        self.user = User.objects.create_user(
            email='test@example.com',
            password='testpass123'
        )
        self.client.force_authenticate(user=self.user)
    
    @patch('config.ai_client.requests.post')
    def test_ai_server_timeout(self, mock_post):
        """Given AI server timeout, When process, Then return timeout error"""
        # Given
        mock_post.side_effect = requests.exceptions.Timeout("Request timeout")
        
        # When
        response = self.client.post(
            '/api/video/1/process/',
            data={"param": "value"},
            format='json'
        )
        
        # Then
        self.assertEqual(response.status_code, 504)
        self.assertIn("timeout", response.data["detail"].lower())
    
    @patch('config.ai_client.requests.post')
    def test_ai_server_connection_error(self, mock_post):
        """Given AI server connection error, When process, Then return error"""
        # Given
        mock_post.side_effect = requests.exceptions.ConnectionError("Connection refused")
        
        # When
        response = self.client.post(
            '/api/video/1/process/',
            data={"param": "value"},
            format='json'
        )
        
        # Then
        self.assertEqual(response.status_code, 500)
        self.assertIn("failed", response.data["detail"].lower())
```

### Phase 6: Test Execution

#### Run All Tests

```bash
# 1. Run all backend tests
docker-compose exec backend python manage.py test -v 2

# 2. Run specific app tests
docker-compose exec backend python manage.py test video.tests -v 2

# 3. Run with coverage
docker-compose exec backend coverage run --source='.' manage.py test
docker-compose exec backend coverage report
docker-compose exec backend coverage html

# 4. Run AI server tests
docker-compose exec ai pytest tests/ -v

# 5. Run integration tests only
docker-compose exec backend python manage.py test video.tests.test_integration -v 2
```

