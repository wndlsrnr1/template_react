    def test_process_video_endpoint_success(self, mock_process):
        """Given valid request, When process, Then return result"""
        # Given
        mock_process.return_value = {"status": "success", "frames": 100}
        
        # When
        response = client.post(
            "/ai/v1/video/process/",
            json={"video_path": "/path/to/video.mp4", "param": "value"}
        )
        
        # Then
        assert response.status_code == 200
        assert response.json()["status"] == "success"
        mock_process.assert_called_once()
    
    def test_process_video_endpoint_invalid_request(self):
        """Given invalid request, When process, Then return 422"""
        # When
        response = client.post(
            "/ai/v1/video/process/",
            json={}  # Missing required fields
        )
        
        # Then
        assert response.status_code == 422
