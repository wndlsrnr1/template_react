## Integration Testing (Service Separation Context)

This guide covers testing strategies for separated services (backend, ai_server) with focus on service-layer tests, integration tests, and E2E tests.

### Core Principles

- **Service-layer first**: Prioritize service tests over view tests
- **TDD workflow**: Red → Green → Refactor
- **Test isolation**: Each test must be independent and deterministic
- **Mock external services**: Mock AI server calls in backend tests, mock media server in AI server tests
- **Integration tests verify wiring**: Test actual HTTP calls between services

### Testing Pyramid

```
        /\
       /  \  E2E Tests (few)
      /____\
     /      \  Integration Tests (some)
    /________\
   /          \  Unit Tests (many)
  /____________\
```

### Phase 1: Unit Tests (Service Layer)

#### Service Test Pattern

```python
# backend/video/tests/test_services.py
from django.test import TestCase
from unittest.mock import Mock, patch
from video.services import VideoService
from video.exceptions import NotFoundServiceError

class VideoServiceTest(TestCase):
    """Unit tests for VideoService - test business logic in isolation"""
    
    def setUp(self):
        # Mock dependencies
        self.mock_video_repo = Mock()
        self.mock_ai_client = Mock()
        
        # Inject mocks
        VideoService.video_repo = self.mock_video_repo
        VideoService.ai_client = self.mock_ai_client
    
    def test_process_video_success(self):
        """Given valid video, When process, Then return result"""
        # Given
        video_mock = Mock(id=1, status='pending')
        self.mock_video_repo.get_by_id_and_user.return_value = video_mock
        self.mock_ai_client.process_video.return_value = {"status": "success"}
        
        # When
        result = VideoService.process_video(
            video_id=1,
            user=Mock(),
            param="value"
        )
        
        # Then
        self.assertEqual(result["video_id"], 1)
        self.mock_ai_client.process_video.assert_called_once()
        self.mock_video_repo.update_status.assert_called_once()
    
    def test_process_video_not_found(self):
        """Given non-existent video, When process, Then raise NotFoundServiceError"""
        # Given
        self.mock_video_repo.get_by_id_and_user.return_value = None
        
        # When/Then
        with self.assertRaises(NotFoundServiceError):
            VideoService.process_video(video_id=999, user=Mock())
```

#### Repository Test Pattern

```python
# backend/video/tests/test_repositories.py
from django.test import TestCase
from video.repositories import VideoRepository
from video.models import Video
from accounts.models import User

class VideoRepositoryTest(TestCase):
    """Unit tests for VideoRepository - test data access in isolation"""
    
    def setUp(self):
        self.user = User.objects.create_user(
            email='test@example.com',
            password='testpass123'
        )
    
    def test_get_by_id_and_user_success(self):
        """Given existing video, When get, Then return video"""
        # Given
        video = Video.objects.create(
            user=self.user,
            title="Test Video",
            file="test.mp4"
        )
        
        # When
        result = VideoRepository.get_by_id_and_user(video.id, self.user)
        
        # Then
        self.assertIsNotNone(result)
        self.assertEqual(result.id, video.id)
    
    def test_get_by_id_and_user_not_found(self):
        """Given non-existent video, When get, Then return None"""
        # When
        result = VideoRepository.get_by_id_and_user(999, self.user)
        
        # Then
        self.assertIsNone(result)
```

### Phase 2: Integration Tests (Service-to-Service)

#### Backend → AI Server HTTP Integration Test

```python
# backend/video/tests/test_integration.py
from django.test import TestCase
from unittest.mock import patch, Mock
from rest_framework.test import APIClient
from django.contrib.auth import get_user_model
from config.ai_client import get_ai_client
import requests

User = get_user_model()

class VideoAIServerIntegrationTest(TestCase):
    """Integration tests for Backend → AI Server communication"""
    
    def setUp(self):
        self.client = APIClient()
        self.user = User.objects.create_user(
            email='test@example.com',
            password='testpass123'
        )
        self.client.force_authenticate(user=self.user)
    
    @patch('config.ai_client.requests.post')
    def test_video_process_calls_ai_server(self, mock_post):
        """Given video process request, When process, Then call AI server"""
        # Given
        mock_response = Mock()
        mock_response.status_code = 200
        mock_response.json.return_value = {"status": "success", "result": {}}
        mock_post.return_value = mock_response
        
        # When
        response = self.client.post(
            '/api/video/1/process/',
            data={"param": "value"},
            format='json'
        )
        
        # Then
        self.assertEqual(response.status_code, 200)
        mock_post.assert_called_once()
        call_args = mock_post.call_args
        self.assertIn('/ai/v1/video/process/', call_args[0][0])
    
    @patch('config.ai_client.requests.post')
    def test_video_process_handles_ai_server_error(self, mock_post):
        """Given AI server error, When process, Then return error response"""
        # Given
        mock_post.side_effect = requests.exceptions.RequestException("Connection error")
        
        # When
        response = self.client.post(
            '/api/video/1/process/',
            data={"param": "value"},
            format='json'
        )
        
        # Then
        self.assertEqual(response.status_code, 500)
        self.assertIn("AI processing failed", response.data["detail"])
```

#### AI Server Endpoint Integration Test

```python
# ai_server/tests/test_video_endpoints.py
from fastapi.testclient import TestClient
from app.main import app
from unittest.mock import patch, Mock

client = TestClient(app)

class VideoEndpointIntegrationTest:
    """Integration tests for AI Server video endpoints"""
    
