### Phase 3: End-to-End Tests

#### Video Processing E2E Test

```python
# backend/video/tests/test_e2e.py
from django.test import TestCase
from rest_framework.test import APIClient
from django.contrib.auth import get_user_model
from video.models import Video
import os

User = get_user_model()

class VideoProcessingE2ETest(TestCase):
    """E2E tests for complete video processing flow"""
    
    def setUp(self):
        self.client = APIClient()
        self.user = User.objects.create_user(
            email='test@example.com',
            password='testpass123'
        )
        self.client.force_authenticate(user=self.user)
    
    @patch('config.ai_client.get_ai_client')
    def test_video_upload_process_flow(self, mock_ai_client):
        """Given video upload, When process, Then complete flow works"""
        # 1. Upload video
        with open('test_video.mp4', 'rb') as f:
            response = self.client.post(
                '/api/video/upload/',
                {'file': f, 'title': 'Test Video'},
                format='multipart'
            )
        self.assertEqual(response.status_code, 201)
        video_id = response.data['id']
        
        # 2. Process video (mock AI server)
        mock_client = Mock()
        mock_client.process_video.return_value = {"status": "success"}
        mock_ai_client.return_value = mock_client
        
        response = self.client.post(
            f'/api/video/{video_id}/process/',
            data={"param": "value"},
            format='json'
        )
        self.assertEqual(response.status_code, 200)
        
        # 3. Verify video status updated
        video = Video.objects.get(id=video_id)
        self.assertEqual(video.status, 'processed')
```

